{
  "name": "grok-build-mcp-server",
  "version": "0.1.0",
  "description": "MCP stdio server exposing the Grok Build CLI as tools for Claude Code, Cursor, and any other MCP client.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "grok",
    "grok-build",
    "xai",
    "claude-code",
    "ai",
    "cli"
  ],
  "license": "MIT",
  "author": "Jorge Montero Varela",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nuruvala/grok-build-to-claude.git"
  },
  "bugs": {
    "url": "https://github.com/Nuruvala/grok-build-to-claude/issues"
  },
  "homepage": "https://github.com/Nuruvala/grok-build-to-claude#readme",
  "type": "module",
  "bin": {
    "grok-build-mcp-server": "dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node --eval \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --import ./tests/no-child-coverage.ts --test \"tests/**/*.test.ts\"",
    "test:coverage": "node --import tsx --import ./tests/no-child-coverage.ts --test --experimental-test-coverage --test-coverage-lines=90 --test-coverage-branches=85 --test-coverage-functions=80 \"tests/**/*.test.ts\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.67.0"
  }
}
